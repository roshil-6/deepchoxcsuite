# Copy to .env.local for local dev. On Render, Vercel, etc., set secrets in the project dashboard.

# --- Vercel ---
# Build command (vercel.json) runs: prisma migrate deploy && next build
# You MUST set DATABASE_URL for Production (and Preview if previews should hit a real DB), or the build fails at migrate.
# If Postgres is on Render: use the External Database URL (hostname like *.render.com), NOT the Internal URL
# (internal hostnames such as dpg-xxxxx-a with no domain are only reachable from other Render services — Vercel gets P1001).
# Optional: NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app for canonical / OG URLs.

# --- Production / hosted (Render, VPS, etc.) ---
# You do NOT need Ollama on the server. AI runs via Groq in the cloud when GROQ_API_KEY is set.
# Minimum for a working hosted app: GROQ_API_KEY (+ DATABASE_URL if you use Prisma).
# Desk model picks (Llama / “fast 8B”) all map to Groq model IDs — no GPU or local LLM required.

# Public site URL — canonical + Open Graph (production). Example: https://your-app.onrender.com
# NEXT_PUBLIC_SITE_URL=https://example.com

# Landing page — hero video (MP4/WebM URL). Optional; placeholder until set.
# NEXT_PUBLIC_LANDING_HERO_VIDEO_URL=

# Hugging Face Inference API — used by /api/chat when GROQ is absent, or when CHAT_USE_HF=1 (Gemma default via HF_CHAT_MODEL)
# HF_API_TOKEN=
# HUGGINGFACE_API_KEY=   # alias — same as HF_API_TOKEN for desk chat + /api/sync
# Optional repo id (default google/gemma-2-2b-it)
# HF_CHAT_MODEL=google/gemma-2-2b-it
# Set to 1 to use Hugging Face before Groq for the floating desk chat (both keys can be set)
# CHAT_USE_HF=1

# Groq (OpenAI-compatible) — primary LLM when set (and CHAT_USE_HF is not forcing HF first)
GROQ_API_KEY=
# Optional default Groq model when routes do not pass a desk id (staff sync, boardroom, etc.).
# Does NOT override the in-app desk model picker — that uses lib/ai/chatProviders.ts mappings.
# Use a current id from Groq docs; deprecated models fail at runtime.
# GROQ_MODEL=llama-3.3-70b-versatile

# Desk id `gemma2` maps to Llama 3.1 8B Instant on Groq (gemma2-9b-it was decommissioned).
# Override only if you use a different Groq text model id:
# GROQ_GEMMA_MODEL=llama-3.1-8b-instant

# CFO funding estimate — desk id for resolveGroqModel (default gemma2 → same fast 8B mapping).
# CFO_FUNDING_MODEL=gemma2

# --- Local dev only (optional — NOT for typical hosted deploys) ---
# DESK_CHAT_FORCE_OLLAMA=1   # desk chat via Ollama first; requires Ollama running on your machine
# OLLAMA_URL=http://127.0.0.1:11434/api/chat   # used when GROQ_API_KEY is empty, or with DESK_CHAT_FORCE_OLLAMA

# PostgreSQL (Render Postgres or other) — enables Prisma + /api/health database: true
# Required for Prisma (Dexo chat in Postgres, health checks, etc.). Copy into .env or .env.local then run: npm run db:migrate
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Dexo live web research (daily briefs / autonomous pulse)
# TAVILY_API_KEY=

# Secure cron trigger secret for /api/dexo/cron-daily (Render cron or external scheduler)
# CRON_SECRET=

# Dexo venture patch policy in UI (always | hybrid | auto). Default is always.
# NEXT_PUBLIC_DEXO_APPROVAL_MODE=always

# Pricing display until auth provides country: IN = rupee-first, INTL = dollar-first. If unset, browser locale/time zone is used (en-IN / Asia/Kolkata → India).
# NEXT_PUBLIC_PRICING_REGION=IN
# NEXT_PUBLIC_PRICING_REGION=INTL

# Razorpay (when you add checkout / webhooks)
# Server-only — never commit or expose to the client
# RAZORPAY_KEY_SECRET=
# Optional: Razorpay Dashboard → Webhooks → signing secret (verify webhook payloads)
# RAZORPAY_WEBHOOK_SECRET=
# Key ID is safe to expose to the browser for Razorpay Checkout.js — use NEXT_PUBLIC_ prefix if you load Checkout on the client
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
